# ------------------------------------------------------------------
# Apache settings for HostGator / cPanel
# ------------------------------------------------------------------
Options -Indexes
DirectoryIndex index.php
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS. Turn on once SSL is active (cPanel > SSL/TLS Status > Run AutoSSL).
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Never serve app code, config or stored data
  RewriteRule ^(app|storage)(/|$) - [F,L]
  RewriteRule (^|/)\.(?!well-known/) - [F,L]

  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^robots\.txt$ robots.php [L]

  # One address per page for SEO: /index.php -> /, /about.php -> /about
  RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
  RewriteRule ^ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+(about|auto-insurance|services|contact|quote|privacy)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # The old Coverage page is now Auto insurance
  RewriteRule ^(es/)?coverage/?$ /$1auto-insurance [R=301,L]

  # Spanish pages live under /es/ and use the same files
  RewriteRule ^es/?$ index.php [L]
  RewriteRule ^es/([a-z-]+)/?$ $1.php [L]

  # Clean URLs: /about serves about.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>

<FilesMatch "\.(sqlite|key|log|md|lock)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
